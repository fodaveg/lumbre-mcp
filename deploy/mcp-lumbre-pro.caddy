# Fragmento de Caddy del borde compartido, para `/srv/edge/conf.d/` del VPS.
#
# ⚠️ Vive AQUÍ y no en el repo `edge-infra` por dos motivos: (1) `/srv/edge` del
# VPS NO es un checkout de git y ese repo lleva divergido desde el 31 jul 2026
# (le faltan `app-lumbre-pro.caddy`, `admin`, `preview`, `demo-lumbre-pro`,
# `lumbre-staging` y `vega.caddy`), así que no es la fuente de verdad de nada;
# (2) el servicio que describe es de este repo. Se publica con:
#
#   scp deploy/mcp-lumbre-pro.caddy lumbre:/srv/edge/conf.d/
#   ssh lumbre-arm 'cd /srv/edge && docker compose --env-file .env exec caddy \
#     caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile'
#
# El servicio vive en `/srv/lumbre-mcp` con su propio Compose
# (`deploy/compose.yml`) y no publica puertos al host: se alcanza solo por el
# DNS de la red `edge`, igual que `lumbre-app`.
#
# Sin `encode`: las respuestas son JSON pequeño y el transporte puede abrir
# SSE, donde comprimir por buffer solo añade latencia.
mcp.lumbre.pro {
	# Tope del cuerpo en el BORDE, para que un cuerpo desmedido ni llegue a
	# ocupar al contenedor. 2MB decimales (2.000.000 bytes) contra los 2 MiB
	# (2.097.152) de `MAX_MCP_BODY_BYTES` en `src/http.ts`: el borde es un pelo
	# MÁS estricto a propósito, así el que corta primero es siempre este y el
	# de la app queda como red de seguridad para quien alcance el contenedor
	# por la red `edge` sin pasar por aquí. Los dos siguen muy por encima del
	# cuerpo legítimo más grande (un `add_attachment` con `content_base64` de
	# 1 MiB decodificado ≈ 1,33 MiB de base64); la cuenta está en el JSDoc de
	# esa constante, y `src/caddy-config.test.ts` comprueba que este número no
	# se despega de ella.
	request_body {
		max_size 2MB
	}

	# Readiness descifra el store y solo pertenece al healthcheck interno del
	# contenedor. El borde no la expone como amplificador público.
	handle /readyz {
		respond 404
	}

	# ── El token del path NUNCA debe llegar a un log ──────────────────────
	#
	# Las conexiones nuevas de claude.ai usan OAuth y la URL limpia `/mcp` (el
	# broker de Lumbre ya está desplegado); se conserva `/mcp/<token>` para los
	# conectores existentes mientras migran.
	# Esa URI heredada es un secreto. Caddy vuelca la URI COMPLETA en sus
	# entradas de `http.log.error` (502, timeout...), que van al log del
	# contenedor `edge-caddy`.
	#
	# MEDIDO el 25 ago 2026, y por eso este bloque es así y no de otra
	# manera: un `log { output discard }` en el sitio NO basta. Solo tapa
	# `http.log.access.log0`; el error sale por `http.log.error.log0`, que
	# ese bloque no incluye. Se comprobó parando el contenedor `lumbre-mcp`
	# y pidiendo `/mcp/deadbeef...` con un token FALSO: el 502 dejó el
	# segmento escrito en claro en el log del borde.
	#
	# La vía que sí funciona es no dejar que el token entre en el pipeline:
	# se saca del path con un matcher, se reescribe la URI a `/mcp` ANTES de
	# cualquier handler, y se reinyecta como cabecera `Authorization` hacia
	# el upstream. Lo que se registre, se registre: la URI ya no lo lleva.
	#
	# El servidor MCP sigue aceptando temporalmente el token en el path (ver
	# `src/http.ts`): esto no lo sustituye, lo cubre por delante. Si alguien
	# apunta al contenedor sin pasar por este borde, sigue autenticando.
	# Si ya hay Authorization, se conserva: la cabecera siempre gana sobre el
	# path también en el borde. El path se reescribe igualmente para que nunca
	# llegue al pipeline de logs.
	@token_en_path_con_auth {
		path_regexp tok_auth ^/mcp/([0-9a-f]{32})$
		header Authorization *
	}
	handle @token_en_path_con_auth {
		rewrite * /mcp
		reverse_proxy lumbre-mcp:8787 {
			flush_interval -1
			request_buffers 2MiB
			transport http {
				dial_timeout 5s
				response_header_timeout 90s
				write_timeout 60s
				keepalive 4s
			}
		}
	}

	# Solo se sintetiza Bearer desde el path cuando la petición no traía ya
	# ninguna Authorization.
	@token_en_path_sin_auth {
		path_regexp tok_noauth ^/mcp/([0-9a-f]{32})$
		header !Authorization
	}
	handle @token_en_path_sin_auth {
		rewrite * /mcp
		reverse_proxy lumbre-mcp:8787 {
			header_up Authorization "Bearer {re.tok_noauth.1}"
			flush_interval -1
			request_buffers 2MiB
			transport http {
				dial_timeout 5s
				response_header_timeout 90s
				write_timeout 60s
				keepalive 4s
			}
		}
	}

	# Todo lo demás va al relé tal cual, y así llegan las rutas OAuth:
	# `/authorize`, `/token`, `/revoke`, `/oauth/lumbre/callback` y las del
	# login con Sumego, `/oauth/sumego/callback`, `/oauth/sumego/consent` y
	# `/oauth/sumego/backchannel-logout` (esta última la llama el servidor de
	# Sumego desde el mismo VPS). Ninguna necesita un handle propio: no
	# llevan secretos en el path, y el log de este host está apagado (abajo).
	# `src/caddy-config.test.ts` comprueba que ningún handle las intercepta.
	handle {
		reverse_proxy lumbre-mcp:8787 {
			# Streamable HTTP mantiene abierta la respuesta SSE mientras dura
			# la petición; sin flush inmediato los eventos se quedarían en el
			# buffer del proxy. Mismo motivo por el que `senda.caddy` sube el
			# `read_timeout` de PocketBase.
			flush_interval -1
			# Cuerpo entero en el borde antes de abrir la petición al
			# contenedor. Sin esto Caddy pasaba el cuerpo según llegaba, y 64
			# subidas lentas con un bearer inventado ocupaban durante 60 s las
			# 64 conexiones del relé (`MCP_MAX_CONNECTIONS`): 502 para todos.
			# Con el búfer, el contenedor solo ve cuerpos completos. 2MiB es
			# `MAX_MCP_BODY_BYTES` (`src/http.ts`) y cubre de sobra el
			# `max_size 2MB` de arriba; `src/caddy-config.test.ts` lo ata.
			request_buffers 2MiB
			# Plazos hacia el contenedor (hallazgo 3 de
			# `docs/audit-abuso-y-limites-20261010.md`; sin ellos, los de Go
			# por defecto: sin tope de espera de respuesta). Los mismos en los
			# tres `reverse_proxy` de este fichero, y
			# `src/caddy-config.test.ts` lo comprueba:
			#  · dial 5s: es la red Docker local; si no conecta en 5 s, el
			#    contenedor no está.
			#  · response_header 90s: con `enableJsonResponse` las cabeceras
			#    salen cuando la tool ha terminado, y una tool puede encadenar
			#    dos o tres peticiones a la app de hasta 30 s cada una
			#    (`src/lumbre-client.ts`). Por encima, 504.
			#  · write 60s: igual que el `requestTimeout` del relé
			#    (`MCP_REQUEST_TIMEOUT_MS` en `src/http.ts`).
			#  · keepalive 4s: Node cierra una conexión ociosa a los 5 s
			#    (`keepAliveTimeout` por defecto). Si Caddy la guardara más
			#    (2 min por defecto), podría reutilizarla justo cuando Node la
			#    cierra y devolver un 502; cerrándola antes que Node, no.
			# El plazo para LEER el cuerpo del cliente
			# (`servers { timeouts { read_body … } }`) es opción global del
			# borde y no cabe en este fragmento: ver `deploy/README-deploy.md`.
			transport http {
				dial_timeout 5s
				response_header_timeout 90s
				write_timeout 60s
				keepalive 4s
			}
		}
	}

	header {
		# `includeSubDomains` alcanza solo a los subdominios de ESTE host
		# (`*.mcp.lumbre.pro`), que no existen: cierra la puerta a que alguien
		# estrene uno mañana sin HSTS, y no toca a `lumbre.pro` ni a sus otros
		# subdominios, que sirven sus propias cabeceras desde sus fragmentos.
		# SIN `preload`, a propósito: eso sí se pide desde el ápice, afecta a
		# todo el dominio y sacarse de la lista lleva meses.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Este host no escribe NINGÚN log en el borde, ni de acceso ni de error.
	# Hacen falta DOS piezas, y este bloque es solo la primera (el acceso).
	#
	# ⚠️ LA SEGUNDA VIVE EN `/srv/edge/Caddyfile`, el bloque global del borde,
	# que NO está en este repo. Es un logger llamado `mcp_errores` con
	# `output discard` e `include http.log.error.mcp`. Sin ella, esto NO
	# protege nada: está medido (dos veces, parando el contenedor
	# `lumbre-mcp` y pidiendo `/mcp/<token falso>`, el 502 dejaba el segmento
	# en claro en el log de `edge-caddy`). Un `log { output discard }` a
	# secas solo tapa `http.log.access.<nombre>`; la entrada que lleva la URI
	# completa sale por `http.log.error.<nombre>`, y el `include` que la
	# atrapa NO se admite dentro del bloque `log` de un sitio, solo en el
	# global. El contenido exacto está en `deploy/README-deploy.md`.
	#
	# El logger se NOMBRA (`mcp`) a propósito: sin nombre, Caddy lo llama
	# `log0` por orden de aparición, y el día que otro fragmento del borde
	# estrene un bloque `log` antes que este, el nombre se desplaza y el
	# `include` del global dejaría de casar EN SILENCIO.
	#
	# Coste: sin registro en el borde para este host. El diagnóstico de un
	# 502 o un timeout se hace con el log del contenedor `lumbre-mcp`, que
	# distingue método y estado y redacta el token (ver `logRequest` en
	# `src/http.ts`).
	log mcp {
		output discard
	}
}

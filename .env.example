# Compartido exclusivamente entre app.lumbre.pro y mcp.lumbre.pro.
# Genera un valor aleatorio estable de al menos 32 caracteres; no lo commitees.
LUMBRE_MCP_BACKCHANNEL_SECRET=

# Cerrado por contrato. Solo se expone para hacer explícita la configuración.
LUMBRE_APP_BASE_URL=https://app.lumbre.pro

# Con quién se identifica la persona al conectar: `lumbre` (por defecto) o
# `sumego`. Cualquier otro valor impide arrancar.
# El issuer de Sumego es https://id.sumego.es (por defecto) o
# https://id.lumbre.pro (admitido); cualquier otro valor impide arrancar.
LUMBRE_MCP_LOGIN_PROVIDER=lumbre
LUMBRE_MCP_OIDC_ISSUER=https://id.sumego.es
LUMBRE_MCP_OIDC_CLIENT_ID=lumbre-mcp
# Secreto del cliente `lumbre-mcp` en Sumego. Obligatorio solo con `sumego`;
# lo da la configuración de Sumego. No lo commitees.
LUMBRE_MCP_OIDC_CLIENT_SECRET=
